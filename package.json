{
  "name": "never-settle-web",
  "version": "1.0.0",
  "private": true,
  "description": "NEVER SETTLE — full-stack fashion store (Next.js, Tailwind CSS, Framer Motion, MySQL, cash on delivery)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@gsap/react": "2.1.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.43.0",
    "gsap": "3.15.0",
    "jose": "^6.2.12",
    "lenis": "1.3.26",
    "mysql2": "^3.24.4",
    "next": "15.5.29",
    "nodemailer": "10.5.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": "6.29.1",
    "postcss": "$postcss",
    "source-map-js": "1.2.2",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
