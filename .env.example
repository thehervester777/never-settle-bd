# ---- Site ----
# Your live address, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.yourdomain.com"
NEXT_PUBLIC_STORE_NAME="NEVER SETTLE"

# ---- Database (MySQL from cPanel → MySQL Databases) ----
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://cpaneluser_ns:CHANGE_ME@localhost:3306/cpaneluser_neversettle"

# ---- Admin login ----
# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# ---- Optional: order emails (leave empty to skip) ----
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="NEVER SETTLE <orders@yourdomain.com>"
ORDER_NOTIFY_EMAIL=""

# ---- Optional: where admin-uploaded product photos are stored (default: the "uploads" folder in the app) ----
# UPLOAD_DIR="/home/youruser/ns-uploads"
