# ---- Site ----
# Your live address, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.yourdomain.com"
NEXT_PUBLIC_STORE_NAME="NEVER SETTLE"

# ---- Database (MySQL from cPanel → MySQL Databases) ----
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://cpaneluser_ns:CHANGE_ME@localhost:3306/cpaneluser_neversettle"
# Cloud databases (TiDB Cloud, Aiven, Railway…) usually require encrypted connections:
# DATABASE_SSL="true"
# Only if your provider gives you a CA certificate (PEM), paste it here (\n for line breaks is fine):
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ---- Admin login ----
# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The store refuses to sign anyone in until you replace this example value.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
# Optional: a separate key for the one-time /admin/setup page. Without it, that page asks for AUTH_SECRET.
# SETUP_KEY=""

# ---- Optional: order emails (leave empty to skip) ----
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="NEVER SETTLE <orders@yourdomain.com>"
ORDER_NOTIFY_EMAIL=""

# ---- Optional: where admin-uploaded product photos are stored (default: the "uploads" folder in the app) ----
# UPLOAD_DIR="/home/youruser/ns-uploads"

# ---- Optional: performance ----
# How long (seconds) each server process keeps product lists, settings and slides in memory. Admin changes
# show at once on the process that made them; other processes (if any) catch up within this time.
# STORE_CACHE_SECONDS="30"
# Database connections per server process (default 8).
# DATABASE_POOL_SIZE="8"
# VPS only (ignored on cPanel): run one worker process per CPU core.
# WEB_CONCURRENCY="4"
# Behind Cloudflare: take the visitor's real IP from Cloudflare, for rate limits.
# CLOUDFLARE="true"
# Number of proxies in front of the app that add to X-Forwarded-For (cPanel Apache or nginx: 1).
# TRUST_PROXY_HOPS="1"

# ---- Vercel only: product photo storage ----
# Vercel can't keep files on disk. Create a Blob store (Vercel → Storage) and connect it to the project;
# Vercel adds this variable for you.
# BLOB_READ_WRITE_TOKEN=""
